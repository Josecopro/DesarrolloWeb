# Copia este archivo a .env.local para desarrollo.

# URL pública del backend (sin /api). La usan el navegador y el servidor de Next (también en el build).
NEXT_PUBLIC_API_HOST=http://localhost:4000

# URL pública del sitio (canonical, sitemap). Opcional en Vercel: se toma del dominio de producción.
# NEXT_PUBLIC_SITE_URL=https://duam.example.com
